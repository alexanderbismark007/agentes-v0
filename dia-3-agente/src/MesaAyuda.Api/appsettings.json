{
  "ConnectionStrings": {
    "BaseDatos": "Host=localhost;Port=5432;Database=mesa_ayuda;Username=mesa;Password=mesa"
  },
  "Datos": {
    "MigrarAlIniciar": true,
    "SembrarAlIniciar": true
  },
  "Proveedores": {
    "Lenguaje": "simulado",
    "Embeddings": "simulado",
    "Nube": {
      "UrlBase": "https://api.openai.com/v1",
      "ClaveApi": "",
      "ModeloLenguaje": "gpt-4o-mini",
      "ModeloEmbeddings": "text-embedding-3-small",
      "DimensionesEmbedding": 384,
      "TiempoEsperaSegundos": 60
    }
  },
  "Agente": {
    "MaximoIteraciones": 6,
    "TiempoMaximoHerramientaSegundos": 30
  },
  "Conocimiento": {
    "TamanoFragmento": 900,
    "SolapamientoFragmento": 150,
    "FragmentosRecuperados": 5,
    "SimilitudMinima": 0.15,
    "CarpetaDocumentos": "documentos",
    "IndexarAlIniciar": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
