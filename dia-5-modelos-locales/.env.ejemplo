# Copie este archivo como .env y ajuste los valores segun su entorno.
# El archivo .env no se versiona: contiene credenciales.
#
# A diferencia de los dias anteriores, varios valores NO tienen valor por
# defecto: el compose se niega a arrancar si faltan. Es deliberado. Una clave
# por defecto que nadie cambia es una clave publica.

# --- Base de datos ---
POSTGRES_DB=mesa_ayuda
POSTGRES_USER=mesa
POSTGRES_PASSWORD=cambie-esta-clave

# --- API ---
PUERTO_API=8080
ASPNETCORE_ENVIRONMENT=Development

# --- Proveedores de modelos ---
# local:    modelos que corren en esta misma infraestructura (por defecto)
# simulado: reglas locales deterministas, sin red ni modelos
# nube:     servicio externo compatible con el formato de la API de OpenAI
PROVEEDOR_LENGUAJE=local
PROVEEDOR_EMBEDDINGS=local

# --- Modelos locales ---
# llama3.2:3b requiere alrededor de 4 GB de memoria. Alternativas:
#   qwen2.5:1.5b   mas liviano, unos 2 GB, respuestas mas breves
#   llama3.1:8b    mejor calidad, unos 8 GB de memoria
MODELO_LENGUAJE=llama3.2:3b

# all-minilm produce vectores de 384 dimensiones, que es el tamano con el
# que esta definida la columna vectorial. Cambiarlo obliga a generar una
# migracion nueva ademas de reindexar.
MODELO_EMBEDDINGS=all-minilm

VENTANA_CONTEXTO=4096
TIEMPO_ESPERA_LOCAL=180

# Limites de recursos del servicio de modelos
LIMITE_MEMORIA_MODELOS=6g
LIMITE_CPU_MODELOS=4
OLLAMA_MODELOS_CARGADOS=1
OLLAMA_TIEMPO_CARGA=10m
OLLAMA_PARALELO=1

# --- Proveedor en la nube (opcional, para comparar) ---
NUBE_URL_BASE=https://api.openai.com/v1
NUBE_CLAVE_API=
NUBE_MODELO=gpt-4o-mini
NUBE_MODELO_EMBEDDINGS=text-embedding-3-small
NUBE_DIMENSIONES=384

# --- Agente ---
AGENTE_MAX_ITERACIONES=6

# --- Orquestacion ---
EXIGIR_FIRMA=true
SECRETO_WEBHOOK=cambie-este-secreto-por-uno-largo-y-aleatorio

# --- n8n ---
PUERTO_N8N=5678
N8N_CLAVE_CIFRADO=cambie-esta-clave-de-cifrado
N8N_AUTENTICACION=true
N8N_USUARIO=admin
N8N_CLAVE=cambie-esta-clave

# --- Correo de prueba ---
PUERTO_CORREO_WEB=8025
