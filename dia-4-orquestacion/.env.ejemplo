# Copie este archivo como .env y ajuste los valores segun su entorno.
# El archivo .env no se versiona: contiene credenciales.

# --- Base de datos ---
POSTGRES_DB=mesa_ayuda
POSTGRES_USER=mesa
POSTGRES_PASSWORD=mesa
PUERTO_BASE_DATOS=5432

# --- API ---
PUERTO_API=8080
ASPNETCORE_ENVIRONMENT=Development

# --- Proveedores de modelos ---
# simulado: reglas locales deterministas, sin red ni credenciales (por defecto)
# nube:     servicio externo compatible con el formato de la API de OpenAI
PROVEEDOR_LENGUAJE=simulado
PROVEEDOR_EMBEDDINGS=simulado

NUBE_URL_BASE=https://api.openai.com/v1
NUBE_CLAVE_API=
NUBE_MODELO=gpt-4o-mini
NUBE_MODELO_EMBEDDINGS=text-embedding-3-small
NUBE_DIMENSIONES=384

# --- Agente ---
AGENTE_MAX_ITERACIONES=6

# --- Orquestacion ---
# En desarrollo la firma viene desactivada para poder probar con curl.
# En cualquier despliegue real debe activarse: la direccion del webhook
# es publica y sin firma cualquiera puede registrar solicitudes falsas.
EXIGIR_FIRMA=false
SECRETO_WEBHOOK=cambie-este-secreto-en-produccion

# --- n8n ---
PUERTO_N8N=5678
N8N_CLAVE_CIFRADO=clave-de-desarrollo-cambiar-en-produccion
N8N_AUTENTICACION=false
N8N_USUARIO=admin
N8N_CLAVE=admin

# --- Correo de prueba ---
PUERTO_CORREO_WEB=8025
PUERTO_CORREO_SMTP=1025
